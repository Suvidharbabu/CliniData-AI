# Copy to .env for local development. On Vercel, set these in Project Settings -> Environment Variables.

# --- Supabase ---------------------------------------------------------------
# Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Only needed if your project still signs JWTs with the legacy HS256 secret.
# New projects use asymmetric signing keys, verified through JWKS automatically.
SUPABASE_JWT_SECRET=
# Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Frontend (baked in at build time by Vite). Anon / publishable key only - never the service role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Neo4j AuraDB -----------------------------------------------------------
NEO4J_URI=neo4j+s://XXXXXXXX.databases.neo4j.io
# Newer Aura instances use the instance ID as the username (see the downloaded credentials file)
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Leave empty to use the user's home database
NEO4J_DATABASE=

# --- Pinecone ---------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX=clinidata

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
# Model that writes the cited gap analysis. Set to claude-haiku-4-5 for lower cost.
ANTHROPIC_MODEL=claude-opus-5-5
# Effort for the answer model: low | medium | high
ANTHROPIC_EFFORT=low
# Cheaper model used only for the HyDE query-expansion passage
ANTHROPIC_HYDE_MODEL=claude-haiku-4-5

# --- App --------------------------------------------------------------------
# Comma-separated list; only needed if the frontend is served from a different origin than the API
ALLOWED_ORIGINS=http://localhost:5173
DAILY_QUERY_LIMIT=20
